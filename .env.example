# Copy to .env (gitignored) and fill in your own values. Nothing here is a credential.

# --- Frontend (Vite; bundled into the browser build) ---
VITE_AWS_REGION=us-east-2
VITE_COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-2.amazonaws.com/Prod

# --- deploy.sh (frontend to S3 + CloudFront) ---
AWS_PROFILE=your-profile
AWS_REGION=us-east-2
WEB_BUCKET=your-website-bucket
CLOUDFRONT_DISTRIBUTION_ID=EXXXXXXXXXXXXX
CLOUDFRONT_DOMAIN=dxxxxxxxxxxxxx.cloudfront.net

# --- backend/*.sh ---
AWS_ACCOUNT_ID=123456789012
MEDIA_BUCKET=your-media-bucket
MEDIA_TABLE=MediaMetadata
GET_MEDIA_ROLE_NAME=getMedia-role-xxxxxxxx
REST_API_ID=xxxxxxxxxx
REST_API_STAGE=Prod
# A Cognito sub whose library the smoke test reads after a deploy (optional)
SMOKE_TEST_USER_ID=
